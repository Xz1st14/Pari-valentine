<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pari ❤️</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: center;
      background: linear-gradient(135deg, #ff6fae, #ffb86c);
      font-family: 'Segoe UI', sans-serif;
      color: #fff;
    }

    .box {
      background: rgba(255,255,255,0.18);
      padding: 40px 30px;
      border-radius: 25px;
      text-align: center;
      box-shadow: 0 25px 50px rgba(0,0,0,0.35);
      max-width: 420px;
      width: 90%;
      z-index: 2;
    }

    h1 {
      font-size: 2.2em;
      margin-bottom: 10px;
    }

    p {
      font-size: 1.15em;
      margin-bottom: 30px;
      line-height: 1.5;
    }

    .buttons {
      position: relative;
      height: 130px;
    }

    button {
      padding: 12px 32px;
      font-size: 1.1em;
      border: none;
      border-radius: 30px;
      cursor: pointer;
      position: absolute;
    }

    #yes {
      background: #2ecc71;
      color: white;
      left: 30px;
      bottom: 0;
    }

    #no {
      background: #ff4d6d;
      color: white;
      right: 30px;
      bottom: 0;
    }

    /* Floating hearts */
    .heart {
      position: absolute;
      bottom: -20px;
      font-size: 20px;
      animation: floatUp 6s linear infinite;
      opacity: 0.8;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(0) scale(1);
        opacity: 0;
      }
      20% { opacity: 1; }
      100% {
        transform: translateY(-110vh) scale(1.5);
        opacity: 0;
      }
    }

    /* Confetti */
    .confetti {
      position: absolute;
      width: 10px;
      height: 10px;
      background: white;
      animation: fall 3s linear forwards;
    }

    @keyframes fall {
      to {
        transform: translateY(100vh) rotate(360deg);
        opacity: 0;
      }
    }
  </style>
</head>
<body>

  <div class="box">
    <h1>Hey Pari 💕</h1>
    <p>
      You make my heart smile without even trying 😌<br><br>
      So here’s my favorite question for you…<br><br>
      <strong>Will you be my Valentine? 💘</strong>
    </p>

    <div class="buttons">
      <button id="yes" onclick="yesClicked()">YES 💖</button>
      <button id="no" onmouseover="moveNo()">NO 🙈</button>
    </div>
  </div>

  <script>
    // Floating hearts
    setInterval(() => {
      const heart = document.createElement("div");
      heart.className = "heart";
      heart.innerText = "❤️";
      heart.style.left = Math.random() * 100 + "vw";
      heart.style.animationDuration = (4 + Math.random() * 3) + "s";
      document.body.appendChild(heart);
      setTimeout(() => heart.remove(), 7000);
    }, 300);

    // NO button dodge
    function moveNo() {
      const noBtn = document.getElementById("no");
      const box = document.querySelector(".buttons");

      const maxX = box.offsetWidth - noBtn.offsetWidth;
      const maxY = box.offsetHeight - noBtn.offsetHeight;

      noBtn.style.left = Math.random() * maxX + "px";
      noBtn.style.top = Math.random() * maxY + "px";
    }

    // YES click celebration
    function yesClicked() {
      document.body.innerHTML = `
        <div style="
          height:100vh;
          display:flex;
          justify-content:center;
          align-items:center;
          background:linear-gradient(135deg,#ff6fae,#ffb86c);
          font-family:'Segoe UI',sans-serif;
          color:white;
          text-align:center;
          padding:20px;
          overflow:hidden;">
          <div>
            <h1>YAYYY!! 🥹💖🎉</h1>
            <p style="font-size:1.3em; line-height:1.5;">
              Pari, you just made my heart explode with happiness ❤️<br><br>
              Best. Valentine. Ever.
            </p>
            <p style="font-size:1.1em;">— Yash 💕</p>
          </div>
        </div>
      `;

      // Party bombers / confetti
      for (let i = 0; i < 120; i++) {
        const confetti = document.createElement("div");
        confetti.className = "confetti";
        confetti.style.left = Math.random() * 100 + "vw";
        confetti.style.top = "-10px";
        confetti.style.background =
          `hsl(${Math.random() * 360}, 100%, 70%)`;
        confetti.style.transform = `rotate(${Math.random() * 360}deg)`;
        document.body.appendChild(confetti);
        setTimeout(() => confetti.remove(), 3000);
      }
    }
  </script>

</body>
</html>
